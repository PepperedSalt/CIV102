locamotive = 400/3

loads = (locamotive/2, locamotive/2, middlefreight/2, middlefreight/2, rightfreight/2, rightfreight/2)


# Reaction force calculations
sumWeight = 0 # weight accumulator
sumMoments = 0 # moment accumulator
for i in range(len(locations)):
    if 0 <= locations[i] <= 1200: # If the load is on the beam
        sumMoments += locations[i] * loads[i] # adding the moment to accumulator
        sumWeight += loads[i] # adding the weight to accumulator

By = sumMoments / 1200
Ay = sumWeight - By

# SFD - function returns the shear force at some x mm from the left
def v(x): # v in range 0 to 1200
    shear = Ay # starts from left reaction force
    appliedload = 0 # accumulator for loads to apply
    for i in range(len(locations)): # looks at all loads
        if 0 <= locations[i] <= x: # if x is past the location of the load and the load is on the beam
            appliedload += loads[i] # apply the load
    shear -= appliedload # subtract the applied load
    return shear

# BMD - function returns the moment at some x mm from the left
def m(x): # m in range 0 to 1200
    moment = Ay * x # moment from the left reaction force acting at distance x
    for i in range(len(locations)): # looks at all loads
        if 0 <= locations[i] <= x: # if x is past the location of the load and the load is on the beam
            moment -= loads[i] * (x - locations[i]) # subtract the load times its lever arm (distance from the load to x)
    return moment

