## ---------------- Design optimization ----------------

# Largest demands over every train position (valid because the section is uniform:
# every FOS is proportional to 1/M or 1/V, so the minimum FOS sits at the largest M and V)
Mmax = 0
Vmax = 0
for x in range(1201):
    if Menv[x] > Mmax:
        Mmax = Menv[x]
    if Venv[x] > Vmax:
        Vmax = Venv[x]

# Versions of Q and b that take the section as an input, so they work for any trial design
def Q_trial(y, plist, yb):
    total = 0
    for w, y0, y1 in plist:
        lo = max(y0, y)
        if y1 > lo:
            total += w * (y1 - lo) * ((lo + y1)/2 - yb)
    return total

def b_trial(y, plist):
    below = 0
    above = 0
    for w, y0, y1 in plist:
        if y0 < y <= y1:
            below = below + w
        if y0 <= y < y1:
            above = above + w
    if below > 0 and above > 0:
        return min(below, above)
    return below + above

# Minimum FOS and governing mode for ANY trial geometry (same formulas as before)
def analyze(topt, topw, bottomt, bottomw, webt, webh, gluew, diaphragm):
    tabw = gluew - webt
    parts = [
        (topw, bottomt + webh, bottomt + webh + topt),
        (2*tabw, bottomt + webh - t, bottomt + webh),
        (2*webt, bottomt, bottomt + webh),
        (bottomw, 0, bottomt),
    ]
    area = topw*topt + 2*t*tabw + 2*webh*webt + bottomw*bottomt
    ybar = (topw*topt*(bottomt+webh+topt/2) + 2*t*tabw*(bottomt+webh-t/2)
            + 2*webh*webt*(bottomt+webh/2) + bottomw*bottomt*bottomt/2) / area
    H = topt + webh + bottomt
    y_top = H - ybar
    y_bot = ybar
    y_topfl = bottomt + webh + topt/2
    y_tab = bottomt + webh - t/2
    y_web = bottomt + webh/2
    y_botfl = bottomt/2
    I = (topw*topt**3/12 + topw*topt*(y_topfl - ybar)**2
         + 2*(tabw*t**3/12 + tabw*t*(y_tab - ybar)**2)
         + 2*(webt*webh**3/12 + webt*webh*(y_web - ybar)**2)
         + bottomw*bottomt**3/12 + bottomw*bottomt*(y_botfl - ybar)**2)

    overhang = (topw - bottomw)/2
    clearw = bottomw - 2*webt
    y_glue = bottomt + webh
    k_plate = pi**2 * E / (12 * (1 - poisson**2))

    # applied stresses at the largest M and V
    sigma_top = Mmax * y_top / I
    sigma_bot = Mmax * y_bot / I
    tau_cent = Vmax * Q_trial(ybar, parts, ybar) / (I * b_trial(ybar, parts))
    tau_glue = Vmax * Q_trial(y_glue, parts, ybar) / (I * b_trial(y_glue, parts))

    # capacities
    sigma_buck1 = 4 * k_plate * (topt/clearw)**2
    if overhang > 0:
        sigma_buck2 = 0.425 * k_plate * (topt/overhang)**2
    else:
        sigma_buck2 = 1e9                       # no overhang, so no overhang buckling
    sigma_buck3 = 6 * k_plate * (webt/(y_top - topt))**2
    tau_buck = 5 * k_plate * ((webt/webh)**2 + (webt/diaphragm)**2)

    results = [
        ("Tension", tens/sigma_bot),
        ("Compression", comp/sigma_top),
        ("Flange buckling (between webs)", sigma_buck1/sigma_top),
        ("Flange buckling (overhangs)", sigma_buck2/sigma_top),
        ("Web flexural buckling", sigma_buck3/sigma_top),
        ("Shear", shear/tau_cent),
        ("Glue shear", shearglue/tau_glue),
        ("Shear buckling", tau_buck/tau_cent),
    ]
    minFOS = 1e9
    failmode = ""
    for name, value in results:
        if value < minFOS:
            minFOS = value
            failmode = name
    return minFOS, failmode

# Matboard needed (mm^2 of sheet) for a trial design
bridge_length = 1250        # mm, minimum allowed length
splice_overlap = 50         # mm, overlap added to every strip (the sheet is only 1016 mm long)
sheet_area = 813 * 1016     # mm^2
usable = 0.85               # fraction of the sheet you can realistically use (cuts, mistakes)

def material_area(topt, topw, bottomt, bottomw, webt, webh, gluew, diaphragm):
    tabw = gluew - webt
    clearw = bottomw - 2*webt
    # total width of all strips: every 1.27 mm layer is its own strip
    stripwidths = topw*(topt/t) + bottomw*(bottomt/t) + 2*webh*(webt/t) + 2*tabw
    area = stripwidths * (bridge_length + splice_overlap)
    n_dia = ceil(1200/diaphragm) + 1             # diaphragms, including the two at the supports
    area += n_dia * clearw * webh                # one layer each
    return area, stripwidths

total_train = 0
for w in original_loads:
    total_train += w
mass_per_mm2 = 750 / sheet_area                  # grams per mm^2 of matboard (about 750 g per sheet)

candidates = []
for H in (80, 100, 120, 140, 160, 180):          # track height must be a multiple of 20 mm
    for ntop in (1, 2, 3):                       # number of 1.27 mm layers
        for nbot in (1, 2):
            for nweb in (1, 2):
                for topw in range(80, 150, 1):
                    for bottomw in range(50, 80, 1):
                        for tab in range(5, 10, 1): # tab width beyond the web
                            for diaphragm in range(50, 400, 1):
                                topt = ntop * t
                                bottomt = nbot * t
                                webt = nweb * t
                                webh = H - topt - bottomt
                                gluew = webt + tab
                                if bottomw - 2*webt <= 0 or bottomw > topw:
                                    continue
                                area, stripwidths = material_area(topt, topw, bottomt, bottomw, webt, webh, gluew, diaphragm)
                                if area > usable * sheet_area:
                                    continue                     # not enough matboard
                                if stripwidths > 813:
                                    continue                     # strips would not fit across the 813 mm width
                                minFOS, failmode = analyze(topt, topw, bottomt, bottomw, webt, webh, gluew, diaphragm)
                                Pfail = minFOS * total_train
                                mass = area * mass_per_mm2
                                candidates.append((Pfail, Pfail/mass, minFOS, failmode, mass, H, ntop, nbot, nweb, topw, bottomw, tab, diaphragm))

# Best by failure load, then best by strength-to-weight
candidates.sort(key=lambda c: c[0], reverse=True)   # key says which entry to sort by
print("Top 5 by failure load:")
for c in candidates[0:5]:
    print(round(c[0]), "N | S/W", round(c[1], 2), "| FOS", round(c[2], 2), c[3], "| mass", round(c[4]), "g | H", c[5], "layers top/bot/web", c[6], c[7], c[8], "topw", c[9], "botw", c[10], "tab", c[11], "dia", c[12])

