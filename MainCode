## Cross-sectional Calculations
# Top flange
topt = 1.27
topw = 100

# Bottom flange
bottomt = 1.27
bottomw = 80

# Webs
webt = 1.27
webh = 75

# Glue Tabs
gluew = 5
tabw = gluew - webt # glue tab width beyond the web

# Matboard
t = 1.27
E = 4000
tens = 30
comp = 6
shear = 4
shearglue = 2
poisson = 0.2

# Calculations

# Parts list to store 4 objects (top and bottom flange, glue tabs, and webs)
parts = [
    (topw, bottomt + webh, bottomt + webh + topt), # top flange
    (2*tabw, bottomt + webh - t, bottomt + webh), # two glue tabs
    (2*webt, bottomt, bottomt + webh), # two webs
    (bottomw, 0, bottomt), # bottom flange
]

ybar = (
    # Top flange
    topw*topt*(bottomt+webh+topt/2)
    # Two glue tabs
    + 2* t*tabw*(bottomt+webh-t/2)
    # Two webs
    + 2* webh*webt*(bottomt+webh/2)
    # Bottom flange
    + bottomw*bottomt*bottomt/2
) / ( # Total area
    topw*topt
    + 2* t*tabw
    + 2* webh*webt
    + bottomw*bottomt
)

H = topt + webh + bottomt # overall height
y_top = H - ybar # distance from centroid to the top
y_bot = ybar # distance from centroid to the bottom

# Centroid heights from the bottom
y_topfl = bottomt + webh + topt/2
y_tab   = bottomt + webh - t/2
y_web   = bottomt + webh/2
y_botfl = bottomt/2

I = (
    # Top flange
    topw*topt**3/12 + topw*topt*(y_topfl - ybar)**2
    # Two glue tabs
    + 2*(tabw*t**3/12 + tabw*t*(y_tab - ybar)**2)
    # Two webs
    + 2*(webt*webh**3/12 + webt*webh*(y_web - ybar)**2)
    # Bottom flange
    + bottomw*bottomt**3/12 + bottomw*bottomt*(y_botfl - ybar)**2
)

# Function to determine Q for some given y above the bottom
def Q(y):
    total = 0
    for w, y0, y1 in parts:
        lo = max(y0, y) # bottom of the part above the cut
        if y1 > lo:
            total += w * (y1 - lo) * ((lo + y1)/2 - ybar) # Adds the area term times the distance from the piece's centroid to ybar
    return total

# Function to determine b for some given y above the bottom
def b(y):
    below = 0 # width of pieces that end at or above y (the side below the cut)
    above = 0 # width of pieces that start at or below y (the side above the cut)

    for w, y0, y1 in parts: # looks through all parts of the cross section
        if y0 < y <= y1: # piece reaches y from below
            below = below + w
        if y0 <= y < y1: # piece reaches y from above
            above = above + w

    if below > 0 and above > 0:
        return min(below, above) # at a boundary, take the narrower side
    return below + above # one of them is zero

## FBD, SFD, and BMD calculations
# Forces (vertical)
